# ==== QRISPay (.env) ==== buat secret: node scripts/gen-secrets.js
NODE_ENV=production
PORT=3000                                   # diabaikan di cPanel (Passenger)
PUBLIC_GATEWAY_URL=https://pay.halogamingzone.com
APP_NAME=QRISPay

# MySQL dari cPanel (Databases -> MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_qrispay
DB_USER=cpaneluser_qrispay
DB_PASS=

# Secret (wajib)
SESSION_SECRET=                             # >= 32 karakter (hex 64), tanda tangan cookie login
PROVIDER_MASTER_KEY=                       # 64 hex, enkripsi token provider operator (GoBiz & ShopeePay)

# Akun admin pertama (dibuat otomatis saat start kalau belum ada admin)
ADMIN_EMAIL=admin@halogamingzone.com
ADMIN_PASSWORD=

# Unique code untuk matching amount-only (rentang inklusif)
UNIQUE_CODE_MIN=21
UNIQUE_CODE_MAX=200

# QRIS expiry (ms) — invoice pembayaran biasa
QRIS_EXPIRY_MS=300000                      # 5 menit
# QRIS expiry untuk pembayaran langganan
SUBSCRIPTION_QRIS_EXPIRY_MS=900000         # 15 menit

# Opsional
REGISTRATION_OPEN=true                     # false = tutup pendaftaran
RATE_LIMIT_PER_MINUTE=60                   # per API key
POLLER_INTERVAL_MS=10000                   # background poller cadence (per provider, idle-when-empty)
MUTASI_LOOKBACK_MINUTES=15                 # window fetch mutasi per poll
UNMATCHED_GRACE_MINUTES=10                 # grace window untuk orphan payment sebelum masuk unmatched
